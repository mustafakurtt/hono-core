{
  "name": "@mustafakurtt/hono-core",
  "version": "0.5.0",
  "description": "Portable Bun + Hono backend core: RBAC, i18n, cache, HTTP error contract, Drizzle base repository, logger, mail, redis, storage, metrics. Mechanisms only — zero project coupling.",
  "license": "MIT",
  "author": "Mustafa Kurt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafakurtt/hono-core.git"
  },
  "keywords": [
    "bun",
    "hono",
    "rbac",
    "drizzle-orm",
    "i18n",
    "cache",
    "backend",
    "starter"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./auth": "./src/auth/index.ts",
    "./cache": "./src/cache/index.ts",
    "./config": "./src/config/index.ts",
    "./db": "./src/db/index.ts",
    "./http": "./src/http/index.ts",
    "./http/validation": "./src/http/validation.ts",
    "./i18n": "./src/i18n/index.ts",
    "./logger": "./src/logger/index.ts",
    "./mail": "./src/mail/index.ts",
    "./metrics": "./src/metrics/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./ratelimit": "./src/ratelimit/index.ts",
    "./rbac": "./src/rbac/index.ts",
    "./redis": "./src/redis/index.ts",
    "./storage": "./src/storage/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:consumer": "bun run scripts/check-consumer.ts",
    "verify": "bun run scripts/verify.ts"
  },
  "peerDependencies": {
    "@hono/zod-validator": ">=0.8.0",
    "drizzle-orm": ">=1.0.0-rc.4 <2",
    "hono": ">=4.12.0",
    "ioredis": ">=5.11.0",
    "nodemailer": ">=9.0.0",
    "pino": ">=9.6.0",
    "prom-client": ">=15.1.0",
    "web-push": ">=3.6.0",
    "zod": ">=4.4.0"
  },
  "peerDependenciesMeta": {
    "@hono/zod-validator": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "web-push": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.27",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "typescript": "^5.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
